{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Acme Design System Tokens",
    "version": "1.0.0",
    "colorSpace": "oklch",
    "description": "Machine-readable mirror of tokens/tokens.css. Sync via Style Dictionary or import directly into Figma Tokens."
  },

  "color": {
    "brand": {
      "mono":        { "value": "oklch(22% 0.015 270)" },
      "monoStrong":  { "value": "oklch(14% 0.012 270)" },
      "monoSoft":    { "value": "oklch(28% 0.02 270)"  }
    },
    "primary": {
      "50":  { "value": "oklch(97% 0.012 262)" },
      "100": { "value": "oklch(94% 0.025 262)" },
      "200": { "value": "oklch(86% 0.06 262)"  },
      "300": { "value": "oklch(72% 0.10 262)"  },
      "400": { "value": "oklch(55% 0.14 262)"  },
      "500": { "value": "oklch(40% 0.14 262)"  },
      "600": { "value": "oklch(32% 0.10 262)"  },
      "700": { "value": "oklch(24% 0.06 262)"  },
      "800": { "value": "oklch(18% 0.04 262)"  },
      "900": { "value": "oklch(12% 0.025 262)" }
    },
    "secondary": {
      "50":  { "value": "oklch(97% 0.005 250)" },
      "100": { "value": "oklch(94% 0.008 250)" },
      "500": { "value": "oklch(56% 0.02 250)"  },
      "700": { "value": "oklch(38% 0.018 250)" },
      "900": { "value": "oklch(22% 0.012 250)" }
    },
    "accent": {
      "50":  { "value": "oklch(97% 0.02 265)" },
      "100": { "value": "oklch(93% 0.05 265)" },
      "200": { "value": "oklch(86% 0.10 265)" },
      "500": { "value": "oklch(58% 0.22 270)" },
      "600": { "value": "oklch(52% 0.24 272)" },
      "700": { "value": "oklch(46% 0.24 274)" }
    },
    "success": {
      "50":  { "value": "oklch(96% 0.03 152)" },
      "500": { "value": "oklch(58% 0.14 152)" },
      "700": { "value": "oklch(46% 0.13 152)" }
    },
    "warning": {
      "50":  { "value": "oklch(96.5% 0.04 80)" },
      "500": { "value": "oklch(70% 0.16 70)"   },
      "700": { "value": "oklch(56% 0.15 60)"   }
    },
    "error": {
      "50":  { "value": "oklch(96% 0.04 25)" },
      "500": { "value": "oklch(58% 0.20 25)" },
      "700": { "value": "oklch(46% 0.19 25)" }
    },
    "info": {
      "50":  { "value": "oklch(96% 0.03 230)" },
      "500": { "value": "oklch(60% 0.14 230)" },
      "700": { "value": "oklch(48% 0.13 230)" }
    },
    "bg": {
      "1":      { "value": "oklch(99% 0.003 90)",   "description": "App background" },
      "2":      { "value": "oklch(100% 0 0)",       "description": "Card / surface" },
      "3":      { "value": "oklch(97.2% 0.004 90)", "description": "Sunken / sidebar" },
      "hover":  { "value": "oklch(95.8% 0.005 90)" },
      "active": { "value": "oklch(93.5% 0.006 90)" },
      "overlay":{ "value": "oklch(15% 0.01 270 / 0.45)" }
    },
    "text": {
      "primary":   { "value": "oklch(18% 0.01 270)" },
      "secondary": { "value": "oklch(42% 0.008 270)" },
      "tertiary":  { "value": "oklch(58% 0.006 270)" },
      "disabled":  { "value": "oklch(72% 0.005 270)" },
      "inverse":   { "value": "oklch(99% 0 0)" },
      "onPrimary": { "value": "oklch(99% 0 0)" }
    },
    "border": {
      "subtle":  { "value": "oklch(93% 0.005 90)" },
      "default": { "value": "oklch(89% 0.005 90)" },
      "strong":  { "value": "oklch(80% 0.006 90)" },
      "focus":   { "value": "oklch(40% 0.14 262)" }
    }
  },

  "typography": {
    "fontFamily": {
      "sans": { "value": "Geist, Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif" },
      "mono": { "value": "'Geist Mono', 'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace" }
    },
    "fontSize": {
      "xs":  { "value": "12px" },
      "sm":  { "value": "13px" },
      "md":  { "value": "14px", "description": "Base body" },
      "lg":  { "value": "16px" },
      "xl":  { "value": "18px" },
      "2xl": { "value": "22px" },
      "3xl": { "value": "28px" },
      "4xl": { "value": "36px" },
      "5xl": { "value": "48px" }
    },
    "fontWeight": {
      "regular":  { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "lineHeight": {
      "tight":   { "value": 1.2 },
      "snug":    { "value": 1.35 },
      "normal":  { "value": 1.5 },
      "relaxed": { "value": 1.7 }
    },
    "letterSpacing": {
      "tight":  { "value": "-0.02em" },
      "normal": { "value": "-0.005em" },
      "wide":   { "value": "0.04em" }
    },
    "heading": {
      "h1": { "fontSize": "3xl", "fontWeight": "semibold", "lineHeight": "tight",  "letterSpacing": "tight" },
      "h2": { "fontSize": "xl",  "fontWeight": "semibold", "lineHeight": "snug",   "letterSpacing": "tight" },
      "h3": { "fontSize": "lg",  "fontWeight": "semibold", "lineHeight": "snug",   "letterSpacing": "normal" },
      "h4": { "fontSize": "md",  "fontWeight": "semibold", "lineHeight": "snug",   "letterSpacing": "normal" }
    },
    "body": {
      "default":  { "fontSize": "md", "fontWeight": "regular", "lineHeight": "normal" },
      "strong":   { "fontSize": "md", "fontWeight": "medium",  "lineHeight": "normal" },
      "small":    { "fontSize": "sm", "fontWeight": "regular", "lineHeight": "normal" }
    },
    "caption":   { "fontSize": "xs", "fontWeight": "regular", "lineHeight": "snug",  "letterSpacing": "wide" }
  },

  "spacing": {
    "_grid":  "4px",
    "0":  { "value": "0px"  },
    "1":  { "value": "4px"  },
    "2":  { "value": "8px"  },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" },
    "10": { "value": "40px" },
    "12": { "value": "48px" },
    "16": { "value": "64px" },
    "20": { "value": "80px" },
    "alias": {
      "xs": { "value": "{spacing.1}" },
      "sm": { "value": "{spacing.2}" },
      "md": { "value": "{spacing.4}" },
      "lg": { "value": "{spacing.6}" },
      "xl": { "value": "{spacing.10}" }
    }
  },

  "radius": {
    "none": { "value": "0"      },
    "sm":   { "value": "4px"    },
    "md":   { "value": "6px"    },
    "lg":   { "value": "8px"    },
    "xl":   { "value": "12px"   },
    "2xl":  { "value": "16px"   },
    "full": { "value": "9999px" }
  },

  "border": {
    "width": {
      "thin":    { "value": "1px" },
      "default": { "value": "1px" },
      "thick":   { "value": "2px" }
    }
  },

  "shadow": {
    "1":     { "value": "0 1px 0 rgb(0 0 0 / 0.04)" },
    "2":     { "value": "0 1px 2px rgb(0 0 0 / 0.05), 0 1px 0 rgb(0 0 0 / 0.02)" },
    "3":     { "value": "0 4px 12px rgb(0 0 0 / 0.06), 0 1px 0 rgb(0 0 0 / 0.03)" },
    "4":     { "value": "0 12px 24px rgb(0 0 0 / 0.08), 0 2px 4px rgb(0 0 0 / 0.04)" },
    "5":     { "value": "0 24px 48px rgb(0 0 0 / 0.12), 0 4px 8px rgb(0 0 0 / 0.06)" },
    "cta":   { "value": "inset 0 1px 0 rgb(255 255 255 / 0.12), 0 1px 2px rgb(0 0 0 / 0.25), 0 0 0 0.5px rgb(0 0 0 / 0.4)" },
    "focus": { "value": "0 0 0 3px oklch(40% 0.14 262 / 0.25)" }
  },

  "zIndex": {
    "base":     { "value": 0    },
    "dropdown": { "value": 1000 },
    "sticky":   { "value": 1020 },
    "overlay":  { "value": 1040 },
    "modal":    { "value": 1050 },
    "popover":  { "value": 1060 },
    "tooltip":  { "value": 1070 },
    "toast":    { "value": 1080 },
    "cmdk":     { "value": 1090 }
  },

  "breakpoint": {
    "xs":  { "value": "480px"  },
    "sm":  { "value": "640px"  },
    "md":  { "value": "768px"  },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },

  "motion": {
    "duration": {
      "instant": { "value": "80ms"  },
      "fast":    { "value": "120ms" },
      "normal":  { "value": "200ms" },
      "slow":    { "value": "320ms" }
    },
    "easing": {
      "standard":   { "value": "cubic-bezier(0.2, 0, 0, 1)" },
      "emphasized": { "value": "cubic-bezier(0.3, 0, 0, 1)" }
    }
  },

  "control": {
    "height": {
      "sm": { "value": "28px" },
      "md": { "value": "36px" },
      "lg": { "value": "44px" }
    },
    "paddingX": {
      "sm": { "value": "10px" },
      "md": { "value": "14px" },
      "lg": { "value": "18px" }
    }
  }
}
